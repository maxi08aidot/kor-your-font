{
  "name": "kor-your-font",
  "version": "0.1.0",
  "description": "손글씨 사진을 진짜 폰트(TTF/WOFF/WOFF2)로 만듭니다 — 한글 완성형 11,172자 지원, 업로드 없음. Turn a photo of your handwriting into a real font, with full Hangul support.",
  "license": "MIT",
  "bin": {
    "kor-your-font": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/e2e.js && node test/hangul.js && node tools/check-site-font.js",
    "build:demo": "esbuild site/demo.src.js --bundle --minify --format=iife --outfile=site/demo.js --external:node:fs --external:wawoff2 --log-level=error",
    "check:site-font": "node tools/check-site-font.js",
    "serve": "node tools/serve.js"
  },
  "keywords": [
    "font",
    "handwriting",
    "hangul",
    "korean",
    "한글",
    "손글씨",
    "ttf",
    "woff2",
    "potrace",
    "claude-skill",
    "handwriting-font"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxi08aidot/kor-your-font.git"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "potrace": "^2.1.8",
    "sharp": "^0.33.4",
    "svg2ttf": "^6.0.3",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "esm-potrace-wasm": "^0.5.0",
    "opentype.js": "^1.3.4"
  },
  "author": "jogwangjae",
  "homepage": "https://maxi08aidot.github.io/kor-your-font/",
  "bugs": {
    "url": "https://github.com/maxi08aidot/kor-your-font/issues"
  }
}
